rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Everything a user's devices sync lives under users/{userId}/: the v1
    // document (data/appData) and the v2 per-item collections (tasks,
    // projects, recurrences, tombstones, log, days, meta). Only the owner's
    // verified Google account may read or write any of it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid == userId &&
        request.auth.token.email == "maxiredigonda@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
